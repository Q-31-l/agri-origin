# 前端环境变量模板（uni-app / Vite）
#
# 用法：
#   cp .env.example .env.development   # 本地开发
#   cp .env.example .env.production    # 生产打包
# 同名变量在 .env.[mode] 里会覆盖 .env，所以模板里给了全部键，按需删掉不用的即可。
#
# 注意：.gitignore 只忽略 .env.local / .env.*.local，
#       .env.development / .env.production / .env.staging 是**会提交**的，
#       所以真实域名要写进去，别人 clone 下来才能直接构建小程序。
#
# 读取入口只有一个：src/config/env.js（其他文件一律从这里 import）。

# 运行模式标识：development / staging / production
VITE_ENV=development

# 应用名与版本（展示用）
VITE_APP_NAME=农安链溯源
VITE_APP_VERSION=1.0.0

# 后端接口地址（不带 /api 后缀）
# - H5：留空即可。开发环境走 vite 代理，生产环境强制走同域 /api（天然免跨域、免配置）
# - 小程序 / App：**必须填完整 origin 且必须是 https**，否则打包后所有请求都发不出去
#   本项目实际值：https://8-147-61-0.sslip.io
VITE_API_BASE=https://8-147-61-0.sslip.io

# 可选：体验版 / 正式版分别指向不同后端时才填。
# 不填则统一用上面的 VITE_API_BASE（本项目单环境，留空即可）
# VITE_API_BASE_TRIAL=https://trial.example.com
# VITE_API_BASE_RELEASE=https://api.example.com

# 是否启用真实上链。false = 演示模式：业务照常跑，但存证记为 SKIPPED，不会伪造"上链成功"
VITE_CHAIN_ENABLED=true

# 控制台调试日志开关
VITE_DEBUG=true

# 单个上传文件大小上限（MB），需 ≤ 后端 storage.max-size
VITE_UPLOAD_MAX_MB=10
