# /opt/agri-origin/app/backend.env
# 由 ops/agri-backend.service 以 EnvironmentFile= 方式加载，仅供 agri-backend 进程读取。
#
#   install -m 600 ops/backend.env.example /opt/agri-origin/app/backend.env
#   vi /opt/agri-origin/app/backend.env
#   systemctl daemon-reload && systemctl restart agri-backend
#
# 注意：本文件已被 .gitignore 忽略，不要提交带真实值的版本。

# 链账户私钥：64 位十六进制，不带 0x 前缀。
# 该地址必须是合约的 owner 或被 owner authorize() 过的账户，
# 否则所有写方法会报 "not authorized"。
CHAIN_PRIVATE_KEY=

# MySQL 口令（对应 application.yml 的 spring.datasource.password）
DB_PASSWORD=change-me

# JWT 签名密钥：建议 32 字节以上随机串
# 生成：openssl rand -hex 32
JWT_SECRET=change-me
